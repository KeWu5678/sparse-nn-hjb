# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so

# ---- Packaging / build ----
build/
dist/
*.egg
*.egg-info/
.eggs/

# ---- Virtual environments ----
.env
.venv/
env/
venv/

# ---- Tests / coverage ----
.pytest_cache/
.cache
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/

# ---- Type checking ----
.mypy_cache/

# ---- Jupyter ----
.ipynb_checkpoints/

# ---- Logs ----
*.log
multirun/

# ---- OS junk ----
.DS_Store
Thumbs.db

# ---- Editor / AI tools  (.vscode/ is intentionally tracked) ----
.idea/
.claude/
.cursor/

# ---- MLflow (local tracking store) ----
mlruns/
mlflow.db
mlflow.db-journal

# ---- Project artifacts: kept locally, not version-controlled ----
outdated/
rawdata/
reference/
plan.md
prompt.md

# ---- autoresearch outputs (scoreboards + per-run JSON/logs) ----
autoresearch/results.tsv
autoresearch/runs/
autoresearch/**/results.tsv
autoresearch/**/runs/
autoresearch/**/*.json
autoresearch/**/*.log

# ---- Private research notes (theory program) ----
docs/research/

# ---- Untracked locally: analysis scripts and experiment artifacts ----
experiments/**/analysis.py
# The retired additive-moment study remains available from Git history; local
# copies may be kept for comparison without being part of the current version.
experiments/*/moment_penalty/
experiments/moment_refinement_common.py
experiments/moment_followup_common.py
experiments/*/paper_log_penalty/
experiments/*/paper_frac_exp_penalty/
experiments/algorithm2_rho_pilot.md
scripts/paper/
scripts/regenerate_paper_artifacts.sh
scripts/refresh_algorithm2_paper_runs.sh
tests/test_paper_artifact_preflight.py

# ---- Terraform (deploy/terraform/) — .terraform.lock.hcl stays tracked ----
deploy/terraform/.terraform/
deploy/terraform/*.tfstate
deploy/terraform/*.tfstate.*
deploy/terraform/*.tfvars
deploy/terraform/*.tfvars.json
!deploy/terraform/example.tfvars

# ---- paper/ (LaTeX working dir) ----
# Only the current source and compiled publication are version-controlled.
# Bibliography, figures, auxiliary files, and working notes stay local.
paper/*
!paper/paper_0805.tex
!paper/paper_0805.pdf

# ---- superseded manuscript versions and their review record: local only ----
docs/paper_archive/

# domain-language notes are local working docs
CONTEXT.md
