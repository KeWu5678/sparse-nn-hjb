# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so

# ---- Packaging / build ----
build/
dist/
*.egg
*.egg-info/
.eggs/

# ---- Virtual environments ----
.env
.venv/
env/
venv/

# ---- Tests / coverage ----
.pytest_cache/
.cache
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/

# ---- Type checking ----
.mypy_cache/

# ---- Jupyter ----
.ipynb_checkpoints/

# ---- Logs ----
*.log
multirun/

# ---- OS junk ----
.DS_Store
Thumbs.db

# ---- Editor / AI tools  (.vscode/ is intentionally tracked) ----
.idea/
.claude/
.cursor/

# ---- MLflow (local tracking store) ----
mlruns/
mlflow.db
mlflow.db-journal

# ---- Project artifacts: kept locally, not version-controlled ----
outdated/
rawdata/
reference/
plan.md

# ---- autoresearch outputs (scoreboards + per-run JSON/logs) ----
autoresearch/results.tsv
autoresearch/runs/
autoresearch/**/results.tsv
autoresearch/**/runs/
autoresearch/**/*.json
autoresearch/**/*.log

# ---- Private research notes (theory program) ----
docs/research/

# ---- Untracked locally: analysis scripts and thesis source ----
experiments/**/analysis.py
!experiments/01_vdp/paper_log_penalty/analysis.py
!experiments/01_vdp/paper_frac_exp_penalty/analysis.py
!experiments/02_pendulum/paper_log_penalty/analysis.py
!experiments/02_pendulum/paper_frac_exp_penalty/analysis.py

# ---- Terraform (deploy/terraform/) — .terraform.lock.hcl stays tracked ----
deploy/terraform/.terraform/
deploy/terraform/*.tfstate
deploy/terraform/*.tfstate.*
deploy/terraform/*.tfvars
deploy/terraform/*.tfvars.json
!deploy/terraform/example.tfvars

# ---- paper/ (LaTeX working dir): the current manuscript and what it builds from ----
# Everything needed to rebuild paper_0805.pdf from a clean checkout is tracked:
# the source, the bibliography, and the figures it includes from paper/plot/.
# (Its other figures come straight from experiments/*/figures/, tracked there.)
paper/*
!paper/paper_0805.tex
!paper/paper_0805.pdf
!paper/ref.bib
!paper/plan.md
!paper/notation.md
!paper/term.md
!paper/plot/
paper/plot/*
!paper/plot/*.png

# ---- superseded manuscript versions and their review record: local only ----
docs/paper_archive/

# domain-language notes are local working docs
CONTEXT.md
