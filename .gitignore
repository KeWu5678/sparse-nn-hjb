# ---- Project artifacts: kept locally, not version-controlled ----
outdated/
rawdata/
reference/
plan.md
prompt.md
/refactor.md

# ---- autoresearch outputs (scoreboards + per-run JSON/logs) ----
autoresearch/results.tsv
autoresearch/runs/
autoresearch/**/results.tsv
autoresearch/**/runs/
autoresearch/**/*.json
autoresearch/**/*.log

# ---- Local notes: docs/ (ADRs, research, manuscript archive) and vault/ ----
# Only the figures the README shows are tracked.
docs/*
!docs/figures/
vault/

# ---- Untracked locally: analysis scripts and experiment artifacts ----
experiments/**/analysis.py
# The retired additive-moment study remains available from Git history; local
# copies may be kept for comparison without being part of the current version.
experiments/*/moment_penalty/
experiments/moment_refinement_common.py
experiments/moment_followup_common.py
experiments/*/paper_log_penalty/
experiments/*/paper_frac_exp_penalty/
experiments/03_high_dimensional/*/
experiments/algorithm2_rho_pilot.md
scripts/paper/
tests/test_paper_artifact_preflight.py

# Hydra's default single-run output dir (sweeps go to rawdata/logs/multirun/).
outputs/

# ---- paper/ (LaTeX working dir) ----
# Only the current source and compiled publication are version-controlled.
# Bibliography, figures, auxiliary files, and working notes stay local.
paper/*
!paper/paper_0805.tex
!paper/paper_0805.pdf
# latexmk settings for building the paper locally.
.latexmkrc

# domain-language notes and agent instructions are local working docs
CONTEXT.md
CLAUDE.md

# ---- Local MLflow container state (deploy/docker/) ----
deploy/docker/mlflow-data/
